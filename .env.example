# Порт веб-сервера
PORT=8080

# Метаданные сервиса
SERVICE_NAME=antipin_service_for_dodeb
APP_VERSION=1.0.0

# Параметры подключения к Kafka (для следующих практик)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_GROUP_ID=antipin-consumer-group
CANDLE_TOPIC=

# Секретный ключ студента (выдается преподавателем)
SECRET_KEY=
